# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Authentication credentials
# Optional: Set these to use real Google OAuth. If empty, the app uses a Sandbox Google Sign-In emulator.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Real SMTP Email Configuration
# Set these to send real email verifications during signup/onboarding.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Admin Support Inbox (Receives in-app Help Center tickets and inquiries)
ADMIN_SUPPORT_EMAIL="admin@stba.org"

# Supabase Integration (Client-side exposed)
VITE_SUPABASE_URL="https://ygsatsfcvodstgjhmths.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inlnc2F0c2Zjdm9kc3RnamhtdGhzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0ODQxNzUsImV4cCI6MjA5NzA2MDE3NX0.Tc4-IvWSmqADtYd2E5_ja3s3V4-lQ9NU51mjST1sbEU"

# Supabase Service Role Key (Server-side secret for Edge Functions & Admin Sync)
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Supabase Edge Function Override URL (Defaults to /functions/v1/parseSDACommentaryDocx)
SUPABASE_EDGE_FUNCTION_URL="https://ygsatsfcvodstgjhmths.supabase.co/functions/v1/parseSDACommentaryDocx"
